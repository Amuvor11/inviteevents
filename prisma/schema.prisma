// Event Invitation Builder — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

enum EventType {
  WEDDING
  BIRTHDAY
  BAPTISM
  GRADUATION
  CORPORATE
  BABY_SHOWER
  OTHER
}

enum GuestInviteStatus {
  PENDING
  SENT
  OPENED
  RESPONDED
}

enum RsvpResponse {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

enum AttendeeType {
  ADULT
  CHILD
}

enum MediaType {
  IMAGE
  VIDEO
  RAW
}

enum QuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  NUMBER
  SELECT
}

// ---------------------------------------------------------------------------
// User & Session
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  displayName String?  @map("display_name")
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  events        Event[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model TemplateCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  templates Template[]

  @@map("template_categories")
}

model Template {
  id           String   @id @default(cuid())
  categoryId   String   @map("category_id")
  name         String
  slug         String   @unique
  description  String?
  thumbnailUrl String   @map("thumbnail_url")
  previewUrl   String?  @map("preview_url")
  structure    Json
  layout       String   @default("classic")
  isPremium    Boolean  @default(false) @map("is_premium")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events   Event[]

  @@index([categoryId, isActive])
  @@map("templates")
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id                 String      @id @default(cuid())
  userId             String      @map("user_id")
  templateId         String?     @map("template_id")
  eventType          EventType   @default(OTHER) @map("event_type")
  title              String
  slug               String      @unique
  hostNames          String?     @map("host_names")
  description        String?     @db.Text
  invitationMessage  String?     @map("invitation_message") @db.Text
  additionalInfo     String?     @map("additional_info") @db.Text
  dressCode          String?     @map("dress_code")
  schedule           Json?
  googleMapsLink     String?     @map("google_maps_link")
  backgroundMusicUrl String?     @map("background_music_url")
  status             EventStatus @default(DRAFT)
  eventDate          DateTime    @map("event_date")
  eventEndDate       DateTime?   @map("event_end_date")
  timezone           String      @default("UTC")
  venueName          String?     @map("venue_name")
  venueAddress       String?     @map("venue_address")
  venueLat           Float?      @map("venue_lat")
  venueLng           Float?      @map("venue_lng")
  coverImageUrl      String?     @map("cover_image_url")
  coverImagePublicId String?     @map("cover_image_public_id")
  customTheme        Json?       @map("custom_theme")
  isPublic           Boolean     @default(true) @map("is_public")
  rsvpClosed         Boolean     @default(false) @map("rsvp_closed")
  maxGuests          Int?        @map("max_guests")
  rsvpDeadline       DateTime?   @map("rsvp_deadline")
  deletedAt          DateTime?   @map("deleted_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  design       InvitationDesign?
  guestGroups  GuestGroup[]
  guests       Guest[]
  media        EventMedia[]
  responses    GuestResponse[]
  questions    Question[]
  guestAnswers GuestAnswer[]

  @@index([userId])
  @@index([status, eventDate])
  @@index([deletedAt])
  @@map("events")
}

model InvitationDesign {
  id                      String   @id @default(cuid())
  eventId                 String   @unique @map("event_id")
  content                 Json
  backgroundImageUrl      String?  @map("background_image_url")
  backgroundImagePublicId String?  @map("background_image_public_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("invitation_designs")
}

// ---------------------------------------------------------------------------
// Guest Groups & Attendees
// ---------------------------------------------------------------------------

model GuestGroup {
  id             String            @id @default(cuid())
  eventId        String            @map("event_id")
  groupName      String?           @map("group_name")
  primaryGuestId String?           @unique @map("primary_guest_id")
  attendeeCount  Int               @default(0) @map("attendee_count")
  inviteToken    String            @unique @map("invite_token")
  inviteStatus   GuestInviteStatus @default(PENDING) @map("invite_status")
  notes          String?           @db.Text
  personalization Json?            @map("personalization")
  sentAt         DateTime?         @map("sent_at")
  openedAt       DateTime?         @map("opened_at")
  lastOpenedAt   DateTime?         @map("last_opened_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests       Guest[]
  primaryGuest Guest?         @relation("PrimaryGuest", fields: [primaryGuestId], references: [id], onDelete: SetNull)
  response     GuestResponse?
  answers      GuestAnswer[]

  @@index([eventId])
  @@map("guest_groups")
}

model Guest {
  id           String       @id @default(cuid())
  groupId      String       @map("group_id")
  eventId      String       @map("event_id")
  name         String
  email        String?
  phone        String?
  isPrimary    Boolean      @default(false) @map("is_primary")
  attendeeType AttendeeType @default(ADULT) @map("attendee_type")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  group        GuestGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  primaryGroup GuestGroup? @relation("PrimaryGuest")
  answers      GuestAnswer[]

  @@index([groupId])
  @@index([eventId])
  @@index([eventId, email])
  @@index([eventId, attendeeType])
  @@map("guests")
}

model GuestResponse {
  id                  String       @id @default(cuid())
  groupId             String       @unique @map("group_id")
  eventId             String       @map("event_id")
  response            RsvpResponse
  message             String?      @db.Text
  dietaryRestrictions String?      @map("dietary_restrictions") @db.Text
  respondedAt         DateTime     @default(now()) @map("responded_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  group   GuestGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers GuestAnswer[]

  @@index([eventId, response])
  @@map("guest_responses")
}

// ---------------------------------------------------------------------------
// Survey / Questionnaire
// ---------------------------------------------------------------------------

model Question {
  id           String       @id @default(cuid())
  eventId      String       @map("event_id")
  type         QuestionType
  title        String
  description  String?      @db.Text
  placeholder  String?
  defaultValue String?      @map("default_value")
  required     Boolean      @default(false)
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers GuestAnswer[]

  @@index([eventId, sortOrder])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  label      String
  value      String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  GuestAnswer[]

  @@index([questionId, sortOrder])
  @@map("question_options")
}

model GuestAnswer {
  id              String   @id @default(cuid())
  groupId         String   @map("group_id")
  guestId         String?  @map("guest_id")
  questionId      String   @map("question_id")
  eventId         String   @map("event_id")
  guestResponseId String?  @map("guest_response_id")
  optionId        String?  @map("option_id")
  textValue       String?  @db.Text
  numberValue     Decimal? @db.Decimal(18, 4)
  boolValue       Boolean?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  group         GuestGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guest         Guest?          @relation(fields: [guestId], references: [id], onDelete: SetNull)
  question      Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  option        QuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  guestResponse GuestResponse?  @relation(fields: [guestResponseId], references: [id], onDelete: SetNull)

  @@unique([groupId, questionId, optionId])
  @@index([eventId, questionId])
  @@index([questionId, optionId])
  @@index([groupId])
  @@index([guestResponseId])
  @@map("guest_answers")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model EventMedia {
  id                 String    @id @default(cuid())
  eventId            String    @map("event_id")
  cloudinaryPublicId String    @map("cloudinary_public_id")
  url                String
  mediaType          MediaType @default(IMAGE) @map("media_type")
  altText            String?   @map("alt_text")
  sortOrder          Int       @default(0) @map("sort_order")
  width              Int?
  height             Int?
  bytes              Int?
  createdAt          DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_media")
}
